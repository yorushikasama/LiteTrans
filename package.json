{
  "name": "litetrans",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "lint:format": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "lint:types": "vue-tsc --noEmit",
    "lint:structure": "node scripts/check-structure.mjs",
    "lint": "npm run lint:format && npm run lint:types && npm run lint:structure",
    "audit:ui": "node scripts/ui-audit.mjs",
    "audit:popup": "node scripts/popup-check.mjs",
    "audit:corners": "node scripts/corner-alpha-check.mjs",
    "audit:theme": "node scripts/theme-check.mjs",
    "shots": "node scripts/make-screenshots.mjs",
    "measure:startup": "node scripts/measure-startup.mjs",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "ui:add": "node scripts/add-shadcn.mjs",
    "release:portable": "bash scripts/make-portable.sh",
    "check": "npm run lint && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@lucide/vue": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.13",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.3.14"
  }
}
